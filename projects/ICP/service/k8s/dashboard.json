{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ocr_request_latency_seconds_bucket{variant=~\"$variant\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ocr_request_latency_seconds_bucket{variant=~\"$variant\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ocr_request_latency_seconds_bucket{variant=~\"$variant\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "title": "Throughput (cards/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ocr_requests_total{status=\"ok\",variant=~\"$variant\"}[1m]))",
          "legendFormat": "ok/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ocr_requests_total{status=\"error\",variant=~\"$variant\"}[1m])) or vector(0)",
          "legendFormat": "error/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Queue length",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ocr_queue_length{variant=~\"$variant\"})",
          "legendFormat": "total"
        },
        {
          "refId": "B",
          "expr": "ocr_queue_length{variant=~\"$variant\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "CPU usage (cores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"icp\",container=\"ocr\"}[1m]))",
          "legendFormat": "{{pod}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"icp\",container=\"ocr\"}[1m]))",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 5,
      "title": "Assertion pass rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ocr_assertions_total{check=\"all\",result=\"pass\",variant=~\"$variant\"}[5m])) / sum(rate(ocr_assertions_total{check=\"all\",variant=~\"$variant\"}[5m]))",
          "legendFormat": "all"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ocr_assertions_total{check=\"a1\",result=\"pass\",variant=~\"$variant\"}[5m])) / sum(rate(ocr_assertions_total{check=\"a1\",variant=~\"$variant\"}[5m]))",
          "legendFormat": "a1"
        },
        {
          "refId": "C",
          "expr": "sum(rate(ocr_assertions_total{check=\"a2\",result=\"pass\",variant=~\"$variant\"}[5m])) / sum(rate(ocr_assertions_total{check=\"a2\",variant=~\"$variant\"}[5m]))",
          "legendFormat": "a2"
        },
        {
          "refId": "D",
          "expr": "sum(rate(ocr_assertions_total{check=\"a3\",result=\"pass\",variant=~\"$variant\"}[5m])) / sum(rate(ocr_assertions_total{check=\"a3\",variant=~\"$variant\"}[5m]))",
          "legendFormat": "a3"
        },
        {
          "refId": "E",
          "expr": "sum(rate(ocr_assertions_total{check=\"a4\",result=\"pass\",variant=~\"$variant\"}[5m])) / sum(rate(ocr_assertions_total{check=\"a4\",variant=~\"$variant\"}[5m]))",
          "legendFormat": "a4"
        }
      ]
    },
    {
      "id": 6,
      "title": "Replicas serving",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"icp-ocr\"} == 1)",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 7,
      "title": "Batch size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(ocr_batch_size{variant=~\"$variant\"})",
          "legendFormat": "avg batch"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["icp", "ocr"],
  "templating": {
    "list": [
      {
        "name": "variant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prom" },
        "query": "label_values(ocr_requests_total, variant)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "ICP OCR — stage: icp-ocr",
  "uid": "icp-ocr-stage",
  "version": 1
}
